{
    "name": "watcher-backend",
    "version": "1.0.0",
    "description": "Course Review & Recommendation Engine - Backend API that helps students navigate online courses with intelligent recommendations",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "nodemon --watch src --watch bootstrap.ts --watch app.ts --ext ts,js,json --exec \"node -r ts-node/register -r tsconfig-paths/register app.ts\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:integration": "jest --testPathPattern=integration",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "format": "biome format --write src/**/*.ts",
        "typecheck": "tsc --noEmit",
        "typeorm": "typeorm-ts-node-commonjs",
        "migration:generate": "pnpm run typeorm -- migration:generate -d src/config/database.ts",
        "migration:run": "pnpm run typeorm -- migration:run -d src/config/database.ts",
        "migration:revert": "pnpm run typeorm -- migration:revert -d src/config/database.ts",
        "db:migrate": "pnpm run migration:run",
        "db:seed": "node -r ts-node/register -r tsconfig-paths/register src/scripts/seed.ts"
    },
    "keywords": [
        "course-review",
        "recommendation-engine",
        "online-courses",
        "education-platform",
        "course-aggregation",
        "nodejs",
        "typescript",
        "typeorm",
        "express",
        "rest-api",
        "machine-learning",
        "web-scraping"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cheerio": "^1.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.4.0",
        "helmet": "^7.1.0",
        "inversify": "^6.0.2",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "node-cron": "^3.0.3",
        "nodemon": "^3.1.4",
        "pg": "^8.12.0",
        "reflect-metadata": "^0.2.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typeorm": "^0.3.20",
        "uuid": "^10.0.0",
        "winston": "^3.14.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.8.3",
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/node": "^22.5.0",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.11.6",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.2.0",
        "@typescript-eslint/parser": "^8.2.0",
        "eslint": "^9.9.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.4",
        "typescript": "^5.5.4"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    }
}
